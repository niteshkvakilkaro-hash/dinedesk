<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash screen: the bell on the brand colour, held until the first page is drawn. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand</item>
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/brand</item>
        <item name="android:colorAccent">#FFF2B544</item>
        <item name="android:statusBarColor">@color/brand</item>
        <item name="android:navigationBarColor">@color/brand</item>
        <item name="android:windowSplashScreenBackground">@color/brand</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
