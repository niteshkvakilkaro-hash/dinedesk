APP_NAME=DineDesk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Store everything in UTC; tenants see their own timezone (default Asia/Kolkata).
APP_TIMEZONE=UTC

# Platform domain. Tenants live at {slug}.PLATFORM_DOMAIN; the app itself at
# PLATFORM_DOMAIN / app.PLATFORM_DOMAIN. Use "localhost" for development
# (Chrome and Firefox resolve *.localhost to 127.0.0.1 automatically).
PLATFORM_DOMAIN=localhost
# Origins allowed to call the API (comma-separated). Wildcards like
# http://*.localhost:5173 are supported for tenant subdomains.
FRONTEND_ORIGINS=http://localhost:5173,http://*.localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dinedesk
DB_USERNAME=root
DB_PASSWORD=

# Development uses the database for cache/queues. In production set
# CACHE_STORE=redis, QUEUE_CONNECTION=redis (see docs/DEPLOYMENT.md).
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

FILESYSTEM_DISK=public
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_TOKEN_EXPIRATION=43200

# OTP delivery for mobile sign-in. "log" writes codes to storage/logs (development only);
# "sms" sends through the messaging driver below (MSG91 when MESSAGING_DRIVER=live).
OTP_DRIVER=log
# Only honoured when APP_ENV=local: return the OTP in the API response so the
# sign-up screen can show it. Never enable in production.
OTP_DEV_ECHO=false

# First super admin, created by `php artisan db:seed`.
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=

# The platform's own Razorpay account: business subscriptions (Phase 8).
# Each business connects its own keys for customer payments in the dashboard.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Links to business sites in customer messages ({host} = business domain)
SITE_URL_PATTERN=https://{host}
# WhatsApp/SMS delivery: log (write to storage/logs) or live.
# live = WhatsApp through Meta's WhatsApp Cloud API (order, booking and stay updates)
#        + SMS through MSG91 for one-time codes only (DLT rules make free-text SMS impossible).
MESSAGING_DRIVER=log
# Meta Business Manager → WhatsApp → API setup: a permanent token and the sender's phone number ID.
# WHATSAPP_TEMPLATE: an approved "utility" template whose body is just {{1}}.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=dinedesk_update
WHATSAPP_TEMPLATE_LANG=en
# MSG91: auth key and a DLT-approved OTP template with one variable (named in MSG91_CODE_VARIABLE).
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_CODE_VARIABLE=otp

# Base URL for uploaded images (relative = same host as the site)
PUBLIC_STORAGE_URL=/storage

# Live updates (Laravel Reverb WebSockets): php artisan reverb:start
# Without Reverb set BROADCAST_CONNECTION=null: the dashboard falls back to polling.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=dinedesk
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Custom domains: owners CNAME their domain here (and/or A records to these IPs).
CUSTOM_DOMAIN_TARGET=
CUSTOM_DOMAIN_IPS=

# Nightly database backups (php artisan backup:database)
BACKUP_KEEP_DAYS=14
MYSQLDUMP_PATH=mysqldump
